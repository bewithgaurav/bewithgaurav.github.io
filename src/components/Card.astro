---
import type { Card } from "../data/site";

interface Props {
  card: Card;
}

const { card } = Astro.props;
---

<article class="card">
  <header>
    <h3>{card.name}</h3>
    <p class="eyebrow">{card.context}</p>
  </header>
  <p class="body">{card.body}</p>
  {
    card.points && (
      <ul class="points">
        {card.points.map((p) => (
          <li>{p}</li>
        ))}
      </ul>
    )
  }
  <ul class="tags" aria-label="Technologies">
    {card.tags.map((t) => <li class="tag">{t}</li>)}
  </ul>
  {
    card.links && (
      <p class="links">
        {card.links.map((l) => (
          <a class="arrow-link" href={l.href} target="_blank" rel="noopener">
            {l.label}
          </a>
        ))}
      </p>
    )
  }
</article>

<style>
  .card {
    display: grid;
    gap: 1rem;
    padding: 1.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    transition:
      border-color 0.25s var(--ease),
      background 0.25s var(--ease);
  }

  .card:hover {
    border-color: var(--border-strong);
    background: var(--surface-hover);
  }

  header {
    display: grid;
    gap: 0.25rem;
  }

  h3 {
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .body {
    font-size: 0.9375rem;
    color: var(--muted);
  }

  .points {
    display: grid;
    gap: 0.5rem;
    font-size: 0.9375rem;
    color: var(--muted);
  }

  .points li {
    position: relative;
    padding-left: 1.125rem;
  }

  .points li::before {
    content: "";
    position: absolute;
    left: 0.125rem;
    top: 0.7em;
    width: 0.375rem;
    height: 1px;
    background: var(--accent);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
  }
</style>
